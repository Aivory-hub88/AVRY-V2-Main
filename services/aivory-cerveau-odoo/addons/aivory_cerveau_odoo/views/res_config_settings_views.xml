<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.aivory.cerveau</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Aivory" string="Aivory" name="aivory_cerveau_odoo">
                    <block title="Aivory" name="aivory_cerveau_setting_container">
                        <setting id="aivory_agents_setting" string="Aivory Agents in Discuss"
                                 help="Each agent you add here appears in Discuss under its own name (Geno, Teo, Lex, Finn, Ofira, Aira) and answers when you @mention it or chat with it directly.">
                            <div class="mt8">
                                <button name="%(aivory_cerveau_odoo.aivory_agent_action)d" type="action"
                                        string="Manage Aivory agents" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
