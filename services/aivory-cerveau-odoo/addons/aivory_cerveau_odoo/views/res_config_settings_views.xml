<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.aivory.cerveau</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Aivory Cerveau" string="Aivory Cerveau" name="aivory_cerveau_odoo">
                    <block title="Aivory Cerveau" name="aivory_cerveau_setting_container">
                        <setting id="aivory_cerveau_base_url_setting" string="Cerveau Base URL" help="The Cerveau instance this Odoo install talks to, e.g. https://cerveau.aivory.uk">
                            <field name="aivory_cerveau_base_url" placeholder="https://cerveau.aivory.uk"/>
                        </setting>
                        <setting id="aivory_cerveau_shared_secret_setting" string="Cerveau Shared Secret" help="Scaffold placeholder -- production auth mechanism is still an open question.">
                            <field name="aivory_cerveau_shared_secret" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
