<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aivory Discuss bot identity. Mirrors how OdooBot itself is built
         (partner + user, see addons/mail_bot): the partner authors the bot's
         messages, the user makes the bot appear in Discuss contacts so anyone
         can open a 1-1 chat with it. Active internal user on purpose: an
         inactive user cannot be messaged. On Enterprise this consumes a seat;
         gate accordingly per prospect. -->
    <record id="aivory_bot_partner" model="res.partner">
        <field name="name">Aivory</field>
        <field name="is_company">False</field>
        <!-- required NOT NULL in Odoo 19 (account); data-file creation does
             not apply the ORM default, so set it explicitly -->
        <field name="autopost_bills">ask</field>
    </record>

    <record id="aivory_bot_user" model="res.users">
        <field name="name">Aivory</field>
        <field name="login">aivory</field>
        <field name="partner_id" ref="aivory_bot_partner"/>
        <field name="active">True</field>
        <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
