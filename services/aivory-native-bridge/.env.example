# aivory-native-bridge — real values live in /home/ubuntu/aivory-native-bridge/.env
# on the VPS (mode 0600). Never commit the real file.

# Shared secret every Cerveau MCP request must present as `x-bridge-key`.
BRIDGE_KEY=

# Shared secret this bridge presents to n8n as `X-Bridge-Secret`. The n8n
# workflows compare against a literal copy of this value in their
# "Check Bridge Secret" node, so the two must be changed together.
N8N_SHARED_SECRET=

# Postgres for the single-query tools that run in this process rather than
# via n8n. Host form, not the Docker service name: the bridge is a systemd
# unit on the host, so it reaches the published port, e.g.
#   postgresql://aivory:<password>@127.0.0.1:5432/aivory
NATIVE_OPS_DATABASE_URL=

# One n8n webhook URL per agent type. Every tool ("action") in that agent's
# module posts to the same URL; the workflow branches internally on `action`.
N8N_WEBHOOK_CUSTOMER_SERVICE=
N8N_WEBHOOK_LEADS_QUALIFIER=
N8N_WEBHOOK_FINANCE_INVOICE_OPS=
N8N_WEBHOOK_OFFICE_ASSISTANT=
