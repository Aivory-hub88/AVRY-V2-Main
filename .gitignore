# =============================================================================
# Aivory Entry Repo — .gitignore
# =============================================================================

# ─── Secrets (never commit) ──────────────────────────────────────────────────
.env
.env.local
.env.production
*.pem
*.key
/vps_key
/ed25519
acme.json
.mcp.json
# Odoo demo live secrets (VPS only, generated from odoo.conf.example)
ops/odoo-demo/odoo.conf
ops/odoo-demo/.env-demo
ops/odoo-demo/golden/*.dump
ops/odoo-demo/golden/*.tar.gz
ops/odoo-demo/golden/*.txt
ops/odoo-demo/backups/

# ─── Docker volumes / runtime data ───────────────────────────────────────────
vps-local/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor ───────────────────────────────────────────────────────────────────
.vscode/
*.swp
*.swo

# ─── Node (shouldn't be in root but just in case) ────────────────────────────
node_modules/

# runtime database artefact, never commit (root-level only -- bare `data/`
# would also ignore Odoo addon data dirs like */addons/*/data/)
/data/

# ─── Rust build artefacts ────────────────────────────────────────────────────
**/target/

# design source files don't belong in a served public/ dir
*.ai

# python cache
__pycache__/
*.pyc
