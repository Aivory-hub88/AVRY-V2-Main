# ─── Aivory Platform — Production Environment ──────────────────────────────
# Copy to .env and fill in real values on the VPS.
# NEVER commit .env to git.

# ─── TLS / Traefik ───────────────────────────────────────────────────────────
ACME_EMAIL=admin@aivory.id

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=your-strong-jwt-secret-min-32-chars

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/aivory

# ─── AI / OpenRouter ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key
DIAGNOSTIC_MODEL=qwen/qwen3-235b-a22b

# ─── Payments / Midtrans ─────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-your-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-key

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ─── Composio ────────────────────────────────────────────────────────────────
COMPOSIO_API_KEY=your-composio-api-key
COMPOSIO_REDIRECT_URL=https://dashboard.aivory.id/integrations/callback

# ─── n8n ─────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin@aivory.local
N8N_BASIC_AUTH_PASSWORD=your-strong-n8n-password
N8N_API_KEY=your-n8n-api-key
N8N_MCP_AUTH_TOKEN=your-mcp-auth-token
N8N_WEBHOOK_URL=https://n8n.aivory.id/

# ─── Internal service auth ───────────────────────────────────────────────────
INTERNAL_TOKEN=your-strong-internal-token-min-32-chars

# ─── Careers service ─────────────────────────────────────────────────────────
ENCRYPTION_KEY=your-64-hex-char-encryption-key
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=careers@aivory.id
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=careers@aivory.id

# ─── Aivory Mail ─────────────────────────────────────────────────────────────
# VPS SMTP + Cloudflare hybrid — choose MAIL_MODE=vps|cloudflare|hybrid
MAIL_MODE=vps
# For Postgres production (required): postgresql://user:pass@avry-mail-db:5432/aivory_mail
# For local/dev: sqlite://./data/mail.db
STORAGE_BACKEND=local
# For R2/S3: set STORAGE_BACKEND=r2 + R2_* below
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
STORAGE_BUCKET=aivory-mail
CF_API_TOKEN=your-cloudflare-api-token-with-Email-Routing-Edit
CF_ZONE_ID=your-cloudflare-zone-id
MAIL_MX_HOST=mail.aivory.uk
SPF_INCLUDE_HOST=_spf.aivory.uk
DMARC_REPORT_ADDRESS=dmarc@aivory.uk
COGNEE_URL=http://cognee-cerveau:3200
COGNEE_INTERNAL_SECRET=your-cognee-secret
COGNEE_AGENT_TYPE=mail_ops
MAIL_INTELLIGENCE_MODEL=deepseek/deepseek-v4-flash-0731
# Web — public env (build-time)
NEXT_PUBLIC_MAIL_API=https://mail.aivory.uk
NEXT_PUBLIC_BOOK_URL=https://book.aivory.uk/book/aivory-call
NEXT_PUBLIC_MAIL_MX_HOST=mail.aivory.uk

# ─── Monitoring ──────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=your-grafana-password
GF_SERVER_ROOT_URL=https://monitoring.aivory.id
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB

# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
CORS_ORIGINS=https://aivory.id,https://dashboard.aivory.id,https://admin.aivory.id,https://console.aivory.id,https://mail.aivory.uk,https://aivory.uk
