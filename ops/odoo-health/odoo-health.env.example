# Copy to /home/ubuntu/odoo-health/odoo-health.env (chmod 600). Everything is optional.
# Without a channel, problems are only logged to the journal (journalctl -u odoo-health).

# Telegram via Geno (what production uses): TELEGRAM_BOT_TOKEN = the shared Geno bot token (avry-backend TELEGRAM_BOT_TOKEN),
# TELEGRAM_CHAT_ID = the owner's private Geno chat id. Or create your own bot with @BotFather, message it once, then get your chat id from
# https://api.telegram.org/bot<token>/getUpdates
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Or any webhook that accepts {"text": "..."} (Slack-compatible, Discord via /slack suffix, n8n, ...)
#ALERT_WEBHOOK_URL=
